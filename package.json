{
  "name": "pafs-portal-frontend",
  "version": "0.0.0",
  "description": "This service provides a user-friendly interface for managing flood and coastal erosion risk management project applications",
  "sideEffects": false,
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:frontend": "vite build",
    "dev": "run-p frontend:watch server:watch",
    "dev:debug": "run-p frontend:watch server:debug",
    "docker:dev": "npm run dev",
    "format": "prettier --write \"src/**/*.js\" \"**/*.{js,cjs,md,json,config.js,test.js}\"",
    "format:check": "prettier --check \"src/**/*.js\" \"**/*.{js,cjs,md,json,config.js,test.js}\"",
    "frontend:watch": "vite build --watch",
    "git:pre-commit-hook": "npm run security-audit && npm run format:check && npm run lint && npm test",
    "security-audit": "npm audit --audit-level=critical",
    "postinstall": "npm run setup:husky",
    "lint": "run-s lint:js lint:scss",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:scss": "stylelint \"src/**/*.scss\" --cache --cache-location .cache/stylelint --cache-strategy content --color --ignore-path .gitignore",
    "test": "cross-env AWS_EMF_ENVIRONMENT=Local TZ=UTC vitest run --coverage",
    "test:unit": "AWS_EMF_ENVIRONMENT=Local TZ=UTC vitest run --workspace=unit",
    "test:integration": "AWS_EMF_ENVIRONMENT=Local TZ=UTC vitest run --workspace=integration",
    "test:watch": "AWS_EMF_ENVIRONMENT=Local TZ=UTC vitest",
    "test:watch:unit": "AWS_EMF_ENVIRONMENT=Local TZ=UTC vitest --workspace=unit",
    "server:watch": "nodemon --inspect=0.0.0.0 --ext js,json --legacy-watch --watch ./src/server --watch ./src/config --env-file-if-exists=.env ./src",
    "server:debug": "nodemon --inspect-brk=0.0.0.0 --ext js,json --legacy-watch --watch ./src/server --watch ./src/config --env-file-if-exists=.env ./src",
    "prestart": "npm run build:frontend",
    "start": "NODE_ENV=production node .",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@defra/cdp-auditing": "0.6.1",
    "@defra/cdp-metrics": "0.6.0",
    "@defra/hapi-secure-context": "0.4.0",
    "@defra/hapi-tracing": "1.30.0",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/catbox-memory": "6.0.2",
    "@hapi/catbox-redis": "7.0.2",
    "@hapi/crumb": "9.0.1",
    "@hapi/hapi": "21.4.9",
    "@hapi/inert": "7.1.2",
    "@hapi/scooter": "8.0.0",
    "@hapi/vision": "7.0.3",
    "@hapi/yar": "11.0.3",
    "aws-embedded-metrics": "4.2.1",
    "blankie": "5.0.0",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "cssnano": "8.0.2",
    "cssnano-preset-default": "8.0.2",
    "date-fns": "4.4.0",
    "exceljs": "4.4.0",
    "global-agent": "4.1.3",
    "govuk-frontend": "6.3.0",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "4.0.0",
    "i18next": "26.3.4",
    "i18next-fs-backend": "2.6.6",
    "ioredis": "5.11.1",
    "joi": "18.2.3",
    "lodash": "4.18.1",
    "node-fetch": "3.3.2",
    "nunjucks": "3.2.4",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "semver": "7.8.5",
    "undici": "8.7.0"
  },
  "devDependencies": {
    "@babel/preset-env": "8.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "cheerio": "1.2.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.4",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "neostandard": "0.13.0",
    "nodemon": "3.1.14",
    "npm-run-all": "4.1.5",
    "prettier": "3.9.4",
    "sass-embedded": "1.100.0",
    "stylelint": "17.14.0",
    "stylelint-config-gds": "3.0.0",
    "vite": "8.1.3",
    "vitest": "4.1.10",
    "vitest-fetch-mock": "0.4.5"
  },
  "overrides": {
    "tmp": "^0.2.7",
    "hapi-pino": {
      "pino": "$pino"
    },
    "joi": "$joi",
    "minimatch": "10.2.4",
    "rollup": "4.59.0",
    "serialize-javascript": "7.0.5",
    "uuid": "^14.0.0",
    "brace-expansion": "5.0.8",
    "fast-uri": "4.1.1",
    "postcss": "8.5.24",
    "svgo": "4.0.2"
  }
}